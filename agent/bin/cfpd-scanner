#!/usr/bin/env node

/**
 * cfpd-scanner: Commit For Personal Data (CFPD) Scanner
 *
 * Scans git staged diffs and files for personal identifiable information (PII),
 * personal emails, API keys, private keys, auth tokens, and forbidden files.
 *
 * Exit code 0: Clean / No sensitive leaks found.
 * Exit code 1: Sensitive leaks detected (commit aborted).
 */

const cp = require("node:child_process");
const fs = require("node:fs");
const path = require("node:path");

// ============================================================================
// ANSI Color Formatting
// ============================================================================
const C = {
  reset: "\x1b[0m",
  bold: "\x1b[1m",
  dim: "\x1b[2m",
  red: "\x1b[38;2;255;70;90m",
  boldRed: "\x1b[1;38;2;255;50;75m",
  green: "\x1b[38;2;80;230;130m",
  yellow: "\x1b[38;2;255;190;60m",
  cyan: "\x1b[38;2;80;210;255m",
  purple: "\x1b[38;2;200;120;255m",
  gray: "\x1b[38;2;120;135;155m",
  bgRed: "\x1b[48;2;180;30;45;1;38;2;255;255;255m",
  boxBorder: "\x1b[38;2;220;50;70m",
  boxBorderClean: "\x1b[38;2;60;180;100m",
};

// ============================================================================
// Detection Rules Definition
// ============================================================================
/**
 * @typedef {Object} Rule
 * @property {string} id
 * @property {string} name
 * @property {"email" | "secret" | "key" | "file" | "pii" | "token"} category
 * @property {"CRITICAL" | "HIGH" | "MEDIUM"} severity
 * @property {RegExp} [pattern]
 * @property {RegExp} [filePattern]
 * @property {(match: string) => string} sanitize
 */

const RULES = [
  // 1. Personal Emails (gmail, yahoo, proton, icloud, hotmail, etc.)
  {
    id: "personal-email",
    name: "Personal Email Address",
    category: "email",
    severity: "HIGH",
    pattern: /\b[A-Za-z0-9._%+-]+@(gmail|yahoo|hotmail|outlook|proton|protonmail|icloud|me|aol)\.[A-Za-z]{2,}\b/gi,
    sanitize: (m) => {
      const parts = m.split("@");
      const name = parts[0];
      const domain = parts[1] || "";
      const redactedName = name.length > 2 ? `${name[0]}***${name.slice(-1)}` : "***";
      return `${redactedName}@${domain}`;
    },
  },

  // 2. Private Keys (RSA, OpenSSH, DSA, EC, PGP)
  {
    id: "private-key",
    name: "Private Key / Certificate Block",
    category: "key",
    severity: "CRITICAL",
    pattern: /-----BEGIN\s+(RSA|OPENSSH|DSA|EC|PGP|ENCRYPTED)?\s*PRIVATE\s+KEY-----/gi,
    sanitize: (m) => m,
  },

  // 3. GitHub Personal Access Tokens & OAuth
  {
    id: "github-token",
    name: "GitHub Access Token (ghp/gho/ghu/pat)",
    category: "secret",
    severity: "CRITICAL",
    pattern: /\b(ghp_[A-Za-z0-9]{36}|gho_[A-Za-z0-9]{36}|ghu_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{82})\b/g,
    sanitize: (m) => `${m.slice(0, 6)}...[REDACTED]`,
  },

  // 4. OpenAI / Anthropic / AI API Keys
  {
    id: "ai-api-key",
    name: "AI API Key (OpenAI / Anthropic / Groq)",
    category: "secret",
    severity: "CRITICAL",
    pattern: /\b(sk-(proj|ant|live|admin)?[A-Za-z0-9_-]{24,})\b/g,
    sanitize: (m) => `${m.slice(0, 7)}...[REDACTED]`,
  },

  // 5. AWS Access Key IDs & Secrets
  {
    id: "aws-key",
    name: "AWS Access Key ID",
    category: "secret",
    severity: "CRITICAL",
    pattern: /\b(AKIA[0-9A-Z]{16})\b/g,
    sanitize: (m) => `${m.slice(0, 4)}...[REDACTED]`,
  },

  // 6. Slack API Tokens
  {
    id: "slack-token",
    name: "Slack API Token",
    category: "secret",
    severity: "CRITICAL",
    pattern: /\b(xox[baprs]-[0-9]{10,13}-[0-9]{10,13}[a-zA-Z0-9]*)\b/g,
    sanitize: (m) => `${m.slice(0, 7)}...[REDACTED]`,
  },

  // 7. Generic Secret Assignments (API Key, Secret, Token, Password)
  {
    id: "generic-secret",
    name: "Hardcoded Secret / Password Assignment",
    category: "secret",
    severity: "HIGH",
    pattern: /(?:(?:api[_-]?key|secret[_-]?key|auth[_-]?token|access[_-]?token|client[_-]?secret|password|passwd)\s*[:=]\s*['"]([^'"\s]{8,})['"])/gi,
    sanitize: (m) => {
      const parts = m.split(/[:=]/);
      return `${parts[0].trim()} = "[REDACTED_SECRET]"`;
    },
  },

  // 8. Bearer Auth Tokens / Raw JWTs
  {
    id: "jwt-token",
    name: "JWT / Bearer Token Header",
    category: "token",
    severity: "HIGH",
    pattern: /\beyJ[A-Za-z0-9-_=]+\.eyJ[A-Za-z0-9-_=]+\.[A-Za-z0-9-_.+/=]+\b/g,
    sanitize: (m) => `${m.slice(0, 10)}...[REDACTED_JWT]`,
  },

  // 9. Personal Phone Numbers
  {
    id: "phone-number",
    name: "Personal Phone Number",
    category: "pii",
    severity: "MEDIUM",
    pattern: /(?:(?:\+?\d{1,3}[-.\s])?\(?\d{3}\)?[-.\s]\d{3}[-.\s]\d{4}|\b(?:\+?\d{1,3}[-.\s])?\d{5}[-.\s]\d{5})\b/g,
    sanitize: (m) => `${m.slice(0, 3)}***${m.slice(-2)}`,
  },

  // 10. Dangerous Staged Files
  {
    id: "forbidden-file",
    name: "Sensitive Environment / Credentials File",
    category: "file",
    severity: "CRITICAL",
    filePattern: /(?:^|\/)(?:\.env(?:\.[a-zA-Z0-9_-]+)?|auth\.json|id_rsa|id_ed25519|.*\.ovpn|credentials\.json)$/i,
    sanitize: (m) => m,
  },
];

// ============================================================================
// Scanner Engine
// ============================================================================
function scanStaged(cwd = process.cwd()) {
  const findings = [];

  // Check 1: Staged file names (check for forbidden files)
  let stagedFilesOutput = "";
  try {
    stagedFilesOutput = cp.execSync("git diff --cached --name-only", {
      cwd,
      encoding: "utf-8",
      stdio: ["pipe", "pipe", "pipe"],
    });
  } catch {
    return findings; // not a git repo or no git
  }

  const stagedFiles = stagedFilesOutput.split("\n").map((s) => s.trim()).filter(Boolean);

  for (const file of stagedFiles) {
    for (const rule of RULES) {
      if (rule.filePattern && rule.filePattern.test(file)) {
        findings.push({
          ruleId: rule.id,
          ruleName: rule.name,
          severity: rule.severity,
          file,
          line: 0,
          snippet: `Tracked sensitive file: ${file}`,
          redacted: `Staged sensitive file: ${file}`,
        });
      }
    }
  }

  // Check 2: Git staged diff additions
  let diffOutput = "";
  try {
    diffOutput = cp.execSync("git diff --cached -U0", {
      cwd,
      encoding: "utf-8",
      stdio: ["pipe", "pipe", "pipe"],
      maxBuffer: 20 * 1024 * 1024,
    });
  } catch {
    return findings;
  }

  if (!diffOutput) return findings;

  const lines = diffOutput.split("\n");
  let currentFile = "";
  let currentLine = 0;

  for (const line of lines) {
    if (line.startsWith("diff --git ")) {
      const match = line.match(/b\/(.*)$/);
      currentFile = match ? match[1] : "";
      continue;
    }

    if (line.startsWith("@@ ")) {
      // e.g. @@ -10,0 +12,4 @@
      const hunkMatch = line.match(/@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@/);
      if (hunkMatch) {
        currentLine = parseInt(hunkMatch[1], 10) - 1;
      }
      continue;
    }

    if (line.startsWith("+") && !line.startsWith("+++")) {
      currentLine++;
      const addedContent = line.slice(1);

      // Skip empty or comment lines if desired, but secrets can be in comments!
      // Exclude git hook or this scanner itself if it quotes patterns
      if (currentFile.includes("cfpd-scanner") || currentFile.includes("cfpd-guard")) {
        continue;
      }

      for (const rule of RULES) {
        if (!rule.pattern) continue;

        // Reset regex state for global regexes
        rule.pattern.lastIndex = 0;
        let match;

        while ((match = rule.pattern.exec(addedContent)) !== null) {
          const rawMatch = match[0];
          const redacted = rule.sanitize(rawMatch);

          // Build context snippet
          const snippet = addedContent.trim().length > 90
            ? `${addedContent.trim().slice(0, 87)}...`
            : addedContent.trim();

          findings.push({
            ruleId: rule.id,
            ruleName: rule.name,
            severity: rule.severity,
            file: currentFile,
            line: currentLine,
            snippet,
            redacted,
          });
        }
      }
    }
  }

  return findings;
}

// ============================================================================
// Box Renderer
// ============================================================================
function renderReport(findings) {
  const width = Math.min(process.stdout.columns || 88, 92);
  const innerWidth = width - 4;

  const pad = (s, len) => {
    const visible = s.replace(/\x1b\[[0-9;]*m/g, "");
    const diff = len - visible.length;
    return diff > 0 ? s + " ".repeat(diff) : s;
  };

  const hr = "─".repeat(innerWidth);
  const doubleHr = "═".repeat(innerWidth);

  console.error("");
  console.error(`${C.boxBorder}╔${doubleHr}╗${C.reset}`);
  console.error(`${C.boxBorder}║${C.reset}  ${C.bgRed} CFPD SHIELD: SENSITIVE DATA LEAK DETECTED ${C.reset}`.padEnd(width + 12) + `${C.boxBorder}║${C.reset}`);
  console.error(`${C.boxBorder}║${C.reset}  ${C.boldRed}COMMIT ABORTED:${C.reset} Personal/confidential data staged for commit.` + " ".repeat(Math.max(0, innerWidth - 58)) + `${C.boxBorder}║${C.reset}`);
  console.error(`${C.boxBorder}╠${hr}╣${C.reset}`);

  // Group by file
  const byFile = new Map();
  for (const f of findings) {
    const list = byFile.get(f.file) || [];
    list.push(f);
    byFile.set(f.file, list);
  }

  for (const [file, items] of byFile.entries()) {
    console.error(`${C.boxBorder}║${C.reset}  ${C.bold}${C.cyan}FILE:${C.reset} ${C.bold}${file}${C.reset}`.padEnd(width + 10) + `${C.boxBorder}║${C.reset}`);

    for (const item of items) {
      const badge = item.severity === "CRITICAL"
        ? `${C.boldRed}[${item.severity}]${C.reset}`
        : `${C.yellow}[${item.severity}]${C.reset}`;
      const lineStr = item.line > 0 ? `line ${item.line}` : "staged file";

      console.error(`${C.boxBorder}║${C.reset}    ${badge} ${C.bold}${item.ruleName}${C.reset} (${C.dim}${lineStr}${C.reset})`.padEnd(width + 18) + `${C.boxBorder}║${C.reset}`);
      console.error(`${C.boxBorder}║${C.reset}      ${C.dim}Preview:${C.reset} ${C.red}${item.redacted}${C.reset}`.padEnd(width + 18) + `${C.boxBorder}║${C.reset}`);
    }
    console.error(`${C.boxBorder}║${C.reset}${" ".repeat(innerWidth)}${C.boxBorder}║${C.reset}`);
  }

  console.error(`${C.boxBorder}╠${hr}╣${C.reset}`);
  console.error(`${C.boxBorder}║${C.reset}  ${C.bold}Remedy:${C.reset} Remove sensitive data from git index:`.padEnd(width + 8) + `${C.boxBorder}║${C.reset}`);
  console.error(`${C.boxBorder}║${C.reset}    ${C.green}git restore --staged <file>${C.reset} or unstage edits.`.padEnd(width + 8) + `${C.boxBorder}║${C.reset}`);
  console.error(`${C.boxBorder}║${C.reset}    To bypass intentionally: ${C.yellow}git commit --no-verify${C.reset}`.padEnd(width + 8) + `${C.boxBorder}║${C.reset}`);
  console.error(`${C.boxBorder}╚${doubleHr}╝${C.reset}`);
  console.error("");
}

// ============================================================================
// CLI Entry Point
// ============================================================================
function main() {
  const args = process.argv.slice(2);

  if (args.includes("--help") || args.includes("-h")) {
    console.log(`CFPD Scanner (Commit For Personal Data)
Usage:
  cfpd-scanner [options]

Options:
  --check      Quiet check, exits 1 on violation, 0 on clean
  --json       Outputs findings as JSON
  --help, -h   Show this help screen
`);
    process.exit(0);
  }

  const isJson = args.includes("--json");
  const isCheckOnly = args.includes("--check");

  const findings = scanStaged(process.cwd());

  if (findings.length === 0) {
    if (!isCheckOnly && !isJson) {
      console.log(`${C.green}✔ [CFPD] Staged files clean. Zero sensitive data detected.${C.reset}`);
    }
    process.exit(0);
  }

  if (isJson) {
    console.log(JSON.stringify(findings, null, 2));
    process.exit(1);
  }

  renderReport(findings);
  process.exit(1);
}

if (require.main === module) {
  main();
}

module.exports = { scanStaged, RULES };
